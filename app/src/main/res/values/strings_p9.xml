    <!-- Privacy Screen -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">Quiet Inbox was engineered from day one to ensure your personal communications never leave your device.</string>
    <string name="privacy_point1_title">100% Offline</string>
    <string name="privacy_point1_desc">Quiet Inbox ships without the INTERNET permission. It is technically impossible for the app to transmit data anywhere.</string>
    <string name="privacy_point2_title">No Accounts or Analytics</string>
    <string name="privacy_point2_desc">There are no user accounts, no tracking SDKs, no ad frameworks, and no crash reporters.</string>
    <string name="privacy_point3_title">Encrypted Storage Sandboxing</string>
    <string name="privacy_point3_desc">All notification records reside solely inside the app\'s private database on your phone.</string>
    <string name="privacy_point4_title">Cloud Backup Excluded</string>
    <string name="privacy_point4_desc">Android cloud backup is explicitly disabled so your private messages are never uploaded to Google Drive.</string>
    <string name="privacy_point5_title">Android 15+ Security Compliance</string>
    <string name="privacy_point5_desc">On modern Android versions, system OTP notifications are automatically redacted from untrusted listeners by the OS.</string>

